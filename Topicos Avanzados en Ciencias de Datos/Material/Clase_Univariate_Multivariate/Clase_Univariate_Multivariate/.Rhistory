# Library
library(ggplot2)
# Crear el data frame con tus datos
data <- data.frame(
"Highly soluble" = c(0, 1, 2, 16, 22, 36, 56, 107),
"Insoluble" = c(0, 0, 0, 2, 0, 1, 1, 4),
"Moderately soluble" = c(37, 16, 7, 193, 127, 252, 784, 402),
"Poorly soluble" = c(8, 4, 3, 47, 39, 64, 190, 126),
"Soluble" = c(22, 29, 15, 141, 114, 210, 570, 570),
"Very soluble" = c(3, 11, 6, 51, 44, 75, 162, 280),
"Clinical_Phase" = c("Phase 1/Phase 2", "Withdrawn", "Phase 2/Phase 3", "Phase 1", "Phase 3", "Phase 2", "Preclinical", "Launched")
)
# Convertir el data frame a formato largo para ggplot2
data_long <- tidyr::gather(data, key = "A_ESOL_Class", value = "Freq", -Clinical_Phase)
# Crear el heatmap con valores de Freq en cada casilla
ggplot(data_long, aes(x = A_ESOL_Class, y = Clinical_Phase, fill = Freq)) +
geom_tile() +
geom_text(aes(label = Freq), vjust = 1) +  # Agregar etiquetas con los valores de Freq
labs(title = "",
x = "A_ESOL_Class",
y = "Clinical Phase",
fill = "Frequency") +
scale_fill_gradient(low = "white", high = "blue") +
theme_minimal() +
theme(
#legend.position = "top",
legend.title = element_blank(),
legend.text = element_text(color = "black", size = 12),
axis.title = element_text(color = "black", face = "bold", size = 14),
axis.text.x = element_text(colour = "black", size = 8, angle = 25),
axis.text.y = element_text(colour = "black", size = 12),
axis.ticks = element_line(colour = "black", size = 0.5),
panel.border = element_rect(colour = "black", fill = NA, size = 1)
)
v1 = c(2,9,1,5,3,7,8)
sum1 = sum(v1)
sum1
mean = sum1/length(v1)
mean
incomes <- c(20000, 75000, 250000, 20000, 600000, 20000, 76000000000000, 600000, 75000, 75000, 75000)
# Contar las recurrencias de los ingresos
recurrencias <- table(incomes)
# Ordenar las recurrencias en orden descendente
recurrencias_ordenadas <- sort(recurrencias, decreasing = TRUE)
# Mostrar las recurrencias ordenadas
recurrencias_ordenadas
IQR <- quantile(gapminder$pop, 0.75) - quantile(gapminder$pop, 0.25)
IQR
IQR(gapminder$pop)
lower_threshold <- quantile(gapminder$pop, 0.25) - 1.5*IQR
lower_threshold
upper_threshold <- quantile(gapminder$pop, 0.75) + 1.5*IQR
upper_threshold
gapminder %>%
filter(pop < lower_threshold | pop > upper_threshold)
a <- faithful
str(faithful)
View(a)
eruption.lm = lm(eruptions ~ waiting, data=faithful)
eruption.lm = lm(eruptions ~ waiting, data=faithful)
summary(eruption.lm)
cov(gapminder$pop, gapminder$year)
duration = faithful$eruptions   # eruption durations
waiting = faithful$waiting      # the waiting period
cov(duration, waiting)
cor.test(faithful$eruptions, faithful$waiting,
method = "pearson")
cor.test(gapminder$pop, gapminder$year,
method = "pearson")
library(ggplot2)
ggplot(gapminder, aes(x=year, y=pop))+
geom_point()
ggplot(faithful, aes(x=eruptions, y=waiting))+
geom_point()
library(dplyr)
gapminder_year <- gapminder %>%
group_by(year) %>%
summarise(totalpop = sum(as.numeric(pop)))
gapminder_year
View(gapminder_year)
#Covariance faithful
cov(faithful$eruptions, faithful$waiting)
#Covariance gapminder modified
cov(gapminder_year$totalpop, gapminder_year$year)
#Pearson faithful
cor.test(faithful$eruptions, faithful$waiting,
method = "pearson")
#Pearson gapminder modified
cor.test(gapminder_year$totalpop, gapminder_year$year,
method = "pearson")
library(gapminder)
#Pearson gapminder modified
cor.test(gapminder_year$totalpop, gapminder_year$year,
method = "pearson")
#Spearman gapminder modified
cor.test(gapminder_year$totalpop, gapminder_year$year,
method = "spearman")
